# The FastAPI backend. This is the only wiring the frontend needs.
#
# The app holds no data of its own - every place, feature, path and route comes
# from here, so the map stays empty until it is running.
#
# See BACKEND.md for the endpoints and response shapes it has to serve.
NEXT_PUBLIC_API_BASE_URL=http://localhost:6767

# The AccessWay API: community features, photo contributions and votes.
#
# A separate service from the one above, with its own contract — a point and a
# radius in, a bare array out. See lib/api/accessway.ts. Leave it unset to use
# the deployed one.
NEXT_PUBLIC_ACCESSWAY_API_URL=https://api.accessway.tech

# Supabase project URL, e.g. https://xxxx.supabase.co
#
# Contribution photos are uploaded straight to Supabase storage with a signed
# URL, and the API hands back a storage path rather than a URL — this is what
# turns one into the other. Optional: uploads work without it, the photos just
# cannot be read back.
NEXT_PUBLIC_SUPABASE_URL=
